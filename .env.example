# Configuração para desenvolvimento local
# Copie para .env. As variáveis definidas no processo prevalecem sobre este arquivo.
APP_ENV=development

# Preencha somente ao executar uma chamada real ao provedor escolhido.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TYPESAFE_API_KEY=

# Conta descartável do PostgreSQL no docker-compose.dev.yml.
# Use somente a URL completa, incluindo banco e opções de conexão necessárias.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Os dois clusters são separados em produção. Localmente, ambos usam o container.
MONGODB_APP_URI=mongodb://localhost:27018
MONGODB_TELEMETRY_URI=mongodb://localhost:27018
MONGO_DB_APP=db_delta_app
MONGO_DB_TELEMETRY=db_delta_telemetry

# Geração padrão: OpenAI Responses. O modo gemini mantém Gemini/Groq anteriores.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# Raciocínio das chamadas rápidas (guarda, roteador, síntese, título). Vazio = igual ao OPENAI_REASONING_EFFORT.
OPENAI_FAST_REASONING_EFFORT=low
# Raciocínio dos agentes especialistas (consumo, previsão, vazamento, hábitos). Vazio = igual ao OPENAI_REASONING_EFFORT.
OPENAI_SPECIALIST_REASONING_EFFORT=high

# Modelos do modo Gemini/Groq e embeddings atuais.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GROQ_SPECIALIST_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=5
JEV_CONFIDENCE_THRESHOLD=0.70
JEV_PROBABILITY_THRESHOLD=0.50
JEV_FACTS_SUPPORTED_THRESHOLD=0.60
JEV_RELEVANCE_THRESHOLD=0.25
JUDGE_SPECIALIST_MODEL=gemini-2.5-flash
LLM_FALLBACK_ENABLED=true
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=4096

# Valores positivos aplicados pelos componentes de banco.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=30

# Pool de conexões PostgreSQL (por processo). Total no banco = workers x DB_POOL_MAX_SIZE,
# que deve ficar abaixo do max_connections do PostgreSQL.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_WAIT_SECONDS=5

# Memória de longo prazo (Qdrant). Sem essas variáveis, long_term.py usa localhost.
QDRANT_URL=
QDRANT_API_KEY=

# RAG: coleção rag_documents existente, 3072 dimensões e acesso de leitura/escrita.
# A tool indexa automaticamente a revisão/modelo atuais quando necessário.
# Trocar o modelo exige reindexar separadamente os resumos de memória.
# Caminhos relativos partem da raiz deste repositório.
# O arquivo define a fonte oficial; alterações são indexadas na próxima consulta RAG.
RAG_DOCUMENT_PATH=app/knowledge/delta-main-source.md

# Console /playground/: habilitado por padrao em development/test.
# Staging/production iniciam com o console desativado; habilite apenas em ambiente restrito.
# DELTA_PLAYGROUND_ENABLED=true

# Autenticação da API: o back-end (delta-api-postgres) emite o token (RS256) e a IA só confere.
# Chave PÚBLICA do back-end (PEM RSA de 2048 bits ou mais): caminho do arquivo (com ou sem file:) ou o próprio
# texto PEM. Obrigatória em staging e produção.
AUTH_PUBLIC_KEY=
# Mesmos valores de auth.issuer, auth.audience e auth.key-id do back-end (padrões delta-api, delta-api e delta-1).
# AUTH_KEY_ID vazio = não confere o kid do cabeçalho.
AUTH_ISSUER=delta-api
AUTH_AUDIENCE=delta-api
AUTH_KEY_ID=delta-1
# Confere em tb_user, a cada requisição, se o usuário existe e está ativo (como faz o back-end).
AUTH_CHECK_ACTIVE=true
# SÓ desenvolvimento e teste: token HS256 com um segredo de 32+ caracteres. Ignorado quando AUTH_PUBLIC_KEY
# está definida (os dois nunca valem ao mesmo tempo) e recusado em staging e produção.
JWT_SECRET=

# Origens permitidas no CORS, separadas por vírgula. Vazio = qualquer origem (como antes).
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com,https://web.exemplo.com

# Conhecimento externo via MCP local (stdio), sem chaves ou porta HTTP.
# Fontes públicas aprovadas estão em app/integrations/mcp/sources.py.
MCP_EXTERNAL_ENABLED=false
MCP_TIMEOUT_SECONDS=45
MCP_CACHE_TTL_SECONDS=3600
# Atualização em segundo plano e validade máxima da última coleta confirmada.
MCP_REFRESH_INTERVAL_SECONDS=3600
MCP_MAX_STALE_SECONDS=86400
# LangSmith (opcional, desligado por padrão). Use só com dados de teste.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=delta-ai
# Prompts e respostas ficam ocultos no LangSmith; só com true eles são enviados (use apenas com dados de teste).
# LANGSMITH_SEND_CONTENT=false

# Premissas do relatório de observabilidade (valores padrão no código).
# OBS_SUPPORT_COST_USD=8.01
# OBS_QUESTIONS_PER_USER_WEEK=0
# OBS_USD_TO_BRL=5.4212
# OBS_LATENCY_P95_LIMIT_MS=8000
# OBS_ERROR_RATE_LIMIT=0.05
# Segredo (16+ caracteres) do hash de usuário; sem ele não há contagem de usuários distintos.
# OBS_HASH_SECRET=
# OBS_PRICES_JSON={"gpt-6-luna": [0.10, 0.50]}
