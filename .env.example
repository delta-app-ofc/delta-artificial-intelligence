# Configuração para desenvolvimento local
# Copie para .env. As variáveis definidas no processo prevalecem sobre este arquivo.
APP_ENV=development

# Preencha somente ao executar uma chamada real ao provedor escolhido.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TYPESAFE_API_KEY=

# Conta descartável do PostgreSQL no docker-compose.dev.yml.
# Use somente a URL completa, incluindo banco e opções de conexão necessárias.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Os dois clusters são separados em produção. Localmente, ambos usam o container.
MONGODB_APP_URI=mongodb://localhost:27018
MONGODB_TELEMETRY_URI=mongodb://localhost:27018
MONGO_DB_APP=db_delta_app
MONGO_DB_TELEMETRY=db_delta_telemetry

# Geração padrão: OpenAI Responses. O modo gemini mantém Gemini/Groq anteriores.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium

# Modelos do modo Gemini/Groq e embeddings atuais.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GROQ_SPECIALIST_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=5
JEV_CONFIDENCE_THRESHOLD=0.70
JEV_PROBABILITY_THRESHOLD=0.50
JEV_FACTS_SUPPORTED_THRESHOLD=0.60
JEV_RELEVANCE_THRESHOLD=0.25
JUDGE_SPECIALIST_MODEL=gemini-2.5-flash
LLM_FALLBACK_ENABLED=true
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=4096

# Valores positivos aplicados pelos componentes de banco.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=30

# Memória de longo prazo (Qdrant). Sem essas variáveis, long_term.py usa localhost.
QDRANT_URL=
QDRANT_API_KEY=

# RAG: coleção rag_documents existente, 3072 dimensões e acesso de leitura/escrita.
# A tool indexa automaticamente a revisão/modelo atuais quando necessário.
# Trocar o modelo exige reindexar separadamente os resumos de memória.
# Caminhos relativos partem da raiz deste repositório.
# O arquivo define a fonte oficial; alterações são indexadas na próxima consulta RAG.
RAG_DOCUMENT_PATH=app/knowledge/delta-main-source.md

# Console /playground/: habilitado por padrao em development/test.
# Staging/production iniciam com o console desativado; habilite apenas em ambiente restrito.
# DELTA_PLAYGROUND_ENABLED=true

# LangSmith (opcional, desligado por padrão). Use só com dados de teste.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=delta-ai

# Premissas do relatório de observabilidade (valores padrão no código).
# OBS_SUPPORT_COST_USD=2.0
# OBS_QUESTIONS_PER_USER_WEEK=5
# OBS_USD_TO_BRL=5.5
# OBS_JEV_COST_USD=0
# OBS_LATENCY_P95_LIMIT_MS=8000
# OBS_ERROR_RATE_LIMIT=0.05
# OBS_PRICES_JSON={"gpt-6-luna": [1.0, 8.0]}
